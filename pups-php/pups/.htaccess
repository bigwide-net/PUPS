# PUPS (Personal Upload Server): every request goes to index.php, which also serves the
# uploads, with the headers that keep them from ever running as a web page.

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header on to PHP; CGI and FastCGI setups drop it otherwise.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Hosting providers prove domain control with files in these folders (for HTTPS
    # certificates). Serve them as they are.
    RewriteRule ^\.well-known/(acme-challenge|pki-validation)/ - [L]

    # webpup, when it is the homepage (installed at /pups/homepage): its script, styles and themes
    # are served as they are. index.html, /p/* and webpup-config.json go through index.php.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(webpups\.js|webpup\.css|theme\.css|webpup-themes/[a-z0-9-]+\.(css|jpg|json))$ - [L]

    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 "PUPS needs mod_rewrite (or another way to send every request to index.php, see README.md)."
</IfModule>
