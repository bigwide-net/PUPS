# The owner's domain, as an origin. It is the owner's identity (`me`), and all URLs derive from it.
# For local tests, map the host name to 127.0.0.1 in /etc/hosts (see README.md).
PUPS_ORIGIN=https://alice.pups.test

# The owner password, confirmed on the consent screen and on the apps page. At least 8 characters.
PUPS_PASSWORD=

# TLS certificate and key (PEM), e.g. made with mkcert. Without them the server speaks plain HTTP.
PUPS_TLS_CERT=certs/alice.pups.test.pem
PUPS_TLS_KEY=certs/alice.pups.test-key.pem

# Port to listen on. Defaults to the port of PUPS_ORIGIN (443 for https).
# Clients always discover https://<host>/, i.e. port 443.
#PUPS_PORT=443
# Accept connections from other machines. By default only connections from this machine are accepted.
#PUPS_ALLOW_REMOTE=true

# Where state.json (grants, hashed tokens) and files/ (uploads, host-meta.json) are kept.
#PUPS_DATA_DIR=data

# Development: allow client metadata documents on private addresses, e.g. a test app at
# https://app.pups.test that resolves to 127.0.0.1. Never enable this on a public server.
PUPS_ALLOW_PRIVATE_CLIENTS=true
# Development: an additional CA certificate to trust when fetching client metadata documents,
# e.g. mkcert's root CA: the file rootCA.pem in the directory that `mkcert -CAROOT` prints.
#PUPS_EXTRA_CA=

# Base URL for public reads, if not storage_base (https://<host>/files/).
#PUPS_PUBLIC_BASE=
# Largest accepted file, in bytes (default 25 MB).
#PUPS_MAX_UPLOAD_BYTES=26214400
# Declare post_endpoint, to test clients' POST fallback.
#PUPS_POST_FALLBACK=true
# Declared well-known paths, as JSON. Default: RFC-6's list at the domain root: the SocialSpec
# files in /.well-known/, /feed.json, /feed/ and /pups/images/ (profile images). If the website
# already serves /feed.json or /feed/ (WordPress does), list the paths without them, e.g.:
#PUPS_WELL_KNOWN_PATHS=[{"path":"/.well-known/about.md","url":"https://alice.pups.test/.well-known/about.md","properties":["https://bigwide.net/ns/name"]},{"path":"/pups/images/","url":"https://alice.pups.test/pups/images/","properties":["https://bigwide.net/ns/avatar"],"url_properties":["https://bigwide.net/ns/avatar"]}]
